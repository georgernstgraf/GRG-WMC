{
    "tasks": {
        "start": "deno run -A main.ts",
        "dev": "deno run -A --watch main.ts",
        "check": "deno check main.ts test/app_test.ts",
        "test": "deno test -A"
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1",
        "hono": "jsr:@hono/hono@^4.13.9"
    },
    "fmt": {
        "indentWidth": 4,
        "exclude": ["static/**/*.html", "static/**/*.css"]
    }
}
