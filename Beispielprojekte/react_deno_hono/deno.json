{
    "nodeModulesDir": "auto",
    "tasks": {
        "dev": "deno run -A npm:vite",
        "api": "deno task --cwd ../hono_on_deno start",
        "build": "deno run -A npm:vite build",
        "preview": "deno run -A npm:vite preview",
        "check": "deno check src vite.config.ts",
        "lint": "deno lint",
        "fmt": "deno fmt",
        "fmt:check": "deno fmt --check",
        "test": "deno test --allow-env --allow-read --preload=./src/test/setup.ts",
        "test:watch": "deno task test --watch",
        "test:coverage": "deno test --allow-env --allow-read --preload=./src/test/setup.ts --coverage=coverage --coverage-threshold=80",
        "verify": "deno task fmt:check && deno task lint && deno task check && deno task test:coverage && deno task build"
    },
    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "types": [
            "react",
            "react-dom",
            "@types/react",
            "@types/react-dom",
            "vite/client"
        ],
        "lib": ["dom", "dom.iterable", "deno.ns"],
        "jsx": "react-jsx",
        "jsxImportSource": "react"
    },
    "imports": {
        "react": "npm:react@^19",
        "react-dom": "npm:react-dom@^19",
        "react/jsx-runtime": "npm:react@^19/jsx-runtime",
        "react/jsx-dev-runtime": "npm:react@^19/jsx-dev-runtime",
        "react-dom/client": "npm:react-dom@^19/client",
        "@types/react": "npm:@types/react@^19",
        "@types/react-dom": "npm:@types/react-dom@^19",
        "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5",
        "vite": "npm:vite@^8",
        "@picocss/pico": "npm:@picocss/pico@^2",
        "@testing-library/react": "npm:@testing-library/react@^16",
        "@happy-dom/global-registrator": "npm:@happy-dom/global-registrator@^18",
        "@std/assert": "jsr:@std/assert@^1"
    },
    "lint": {
        "rules": {
            "include": ["react-rules-of-hooks"]
        }
    },
    "fmt": {
        "indentWidth": 4,
        "exclude": [
            "dist/",
            "coverage/",
            "node_modules/",
            "index.html",
            "public/**/*.svg"
        ]
    },
    "test": {
        "include": ["src/**/*_test.ts", "src/**/*_test.tsx"]
    }
}
